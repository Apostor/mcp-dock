# Servers to enable (comma-separated)
# Available: trello, google-drive, github, gitlab, slack, notion, linear, jira, telegram, whatsapp
ENABLED_SERVERS=

# Token storage path inside the container (bind-mounted from ./tokens on the host)
TOKENS_PATH=/opt/app/tokens

# Credentials directory inside the container (bind-mounted from ./credentials on the host)
CREDENTIALS_PATH=/opt/app/credentials

# ── Gateway ───────────────────────────────────────────────────────────────────
# Set to false to disable API key auth, tool governance, and audit logging.
GATEWAY_ENABLED=true

# Path to gateway.yaml inside the container (bind-mounted from ./gateway.yaml on the host).
GATEWAY_CONFIG_PATH=/opt/app/gateway.yaml
